---
// src/pages/download.astro
import Layout from '../layouts/Layout.astro';
import { 
  GITHUB_RELEASES_URL, 
  ASSET_CONFIG, 
  fetchTargetRelease, 
  generateDownloadUrls 
} from '../data/downloads';

// Dynamically resolve target release (stable first, fallback to pre-release) at build time
const targetRelease = await fetchTargetRelease();
const currentTag = targetRelease?.tagName ?? "v0.0.6-alpha";
const isPrerelease = targetRelease?.isPrerelease ?? true;
const currentVersion = targetRelease?.version ?? currentTag.replace(/^v/, '');
const downloads = targetRelease?.downloads ?? generateDownloadUrls(currentTag);

// Platform download items with direct download binary URLs derived from workflow patterns
const platformData = {
  linux: {
    name: "Linux",
    subtitle: "Linux Downloads",
    binaries: [
      {
        id: "deb",
        name: ASSET_CONFIG.deb.name,
        badge: ASSET_CONFIG.deb.badge,
        desc: ASSET_CONFIG.deb.desc,
        url: downloads.deb,
        filename: ASSET_CONFIG.deb.filenameTemplate(currentVersion),
      },
      {
        id: "targz",
        name: ASSET_CONFIG.targz.name,
        badge: ASSET_CONFIG.targz.badge,
        desc: ASSET_CONFIG.targz.desc,
        url: downloads.targz,
        filename: ASSET_CONFIG.targz.filenameTemplate(currentVersion),
      },
    ],
  },
  windows: {
    name: "Windows",
    subtitle: "Windows Downloads",
    binaries: [
      {
        id: "exe",
        name: ASSET_CONFIG.exe.name,
        badge: ASSET_CONFIG.exe.badge,
        desc: ASSET_CONFIG.exe.desc,
        url: downloads.exe,
        filename: ASSET_CONFIG.exe.filenameTemplate(currentVersion),
      },
      {
        id: "msi",
        name: ASSET_CONFIG.msi.name,
        badge: ASSET_CONFIG.msi.badge,
        desc: ASSET_CONFIG.msi.desc,
        url: downloads.msi,
        filename: ASSET_CONFIG.msi.filenameTemplate(currentVersion),
      },
      {
        id: "zip",
        name: ASSET_CONFIG.zip.name,
        badge: ASSET_CONFIG.zip.badge,
        desc: ASSET_CONFIG.zip.desc,
        url: downloads.zip,
        filename: ASSET_CONFIG.zip.filenameTemplate(currentVersion),
      },
    ],
  },
  android: {
    name: "Android",
    subtitle: "Android Downloads",
    binaries: [
      {
        id: "apk",
        name: ASSET_CONFIG.apk.name,
        badge: ASSET_CONFIG.apk.badge,
        desc: ASSET_CONFIG.apk.desc,
        url: downloads.apk,
        filename: ASSET_CONFIG.apk.filenameTemplate(currentVersion),
      },
    ],
  },
};
---

<Layout 
  title="Download Folder Share — Free & Open Source Local Sharing" 
  description="Download Folder Share for Windows, Linux, and Android. Direct downloads for DEB, TAR.GZ, MSI, and APK. 100% Free, zero cloud."
>
  <div class="download-page-wrapper">
    <div class="container">
      
      <!-- Page Header -->
      <div class="download-header">
        <h1 class="download-page-title">Downloads</h1>
        <div class="download-version-badge" title="Active Release Version">
          <span class="version-dot"></span>
          <span data-release-label>{currentTag} ({isPrerelease ? "Pre-release" : "Latest Stable"})</span>
        </div>
        <p class="download-platform-subtitle" id="platform-subtitle">Linux Downloads</p>
      </div>

      <!-- Platform Selection Pills Bar -->
      <div class="platform-nav-bar" role="tablist" aria-label="Select Operating System">
        <button 
          type="button" 
          class="platform-pill" 
          role="tab" 
          id="pill-windows" 
          data-platform="windows" 
          aria-selected="false"
          aria-controls="panel-windows"
        >
          <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M0 0h11.377v11.372H0Zm12.623 0H24v11.372H12.623ZM0 12.623h11.377V24H0Zm12.623 0H24V24H12.623"/>
          </svg>
          <span>Windows</span>
        </button>

        <button 
          type="button" 
          class="platform-pill" 
          role="tab" 
          id="pill-linux" 
          data-platform="linux" 
          aria-selected="true"
          aria-controls="panel-linux"
        >
          <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.504 0q-.232 0-.48.021c-4.226.333-3.105 4.807-3.17 6.298c-.076 1.092-.3 1.953-1.05 3.02c-.885 1.051-2.127 2.75-2.716 4.521c-.278.832-.41 1.684-.287 2.489a.4.4 0 0 0-.11.135c-.26.268-.45.6-.663.839c-.199.199-.485.267-.797.4c-.313.136-.658.269-.864.68c-.09.189-.136.394-.132.602c0 .199.027.4.055.536c.058.399.116.728.04.97c-.249.68-.28 1.145-.106 1.484c.174.334.535.47.94.601c.81.2 1.91.135 2.774.6c.926.466 1.866.67 2.616.47c.526-.116.97-.464 1.208-.946c.587-.003 1.23-.269 2.26-.334c.699-.058 1.574.267 2.577.2c.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071s1.592-.536 2.257-1.306c.631-.765 1.683-1.084 2.378-1.503c.348-.199.629-.469.649-.853c.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926c-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.36.36 0 0 0-.19-.064c.431-1.278.264-2.55-.173-3.694c-.533-1.41-1.465-2.638-2.175-3.483c-.796-1.005-1.576-1.957-1.56-3.368c.026-2.152.236-6.133-3.544-6.139m.529 3.405h.013c.213 0 .396.062.584.198c.19.135.33.332.438.533c.105.259.158.459.166.724c0-.02.006-.04.006-.06v.105l-.004-.021l-.004-.024a1.8 1.8 0 0 1-.15.706a.95.95 0 0 1-.213.335a1 1 0 0 0-.088-.042c-.104-.045-.198-.064-.284-.133a1.3 1.3 0 0 0-.22-.066c.05-.06.146-.133.183-.198q.08-.193.088-.402v-.02a1.2 1.2 0 0 0-.061-.4c-.045-.134-.101-.2-.183-.333c-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 0 0-.205.334a1.2 1.2 0 0 0-.09.4v.019q.002.134.02.267c-.193-.067-.438-.135-.607-.202a2 2 0 0 1-.018-.2v-.02a1.8 1.8 0 0 1 .15-.768a1.08 1.08 0 0 1 .43-.533a1 1 0 0 1 .594-.2zm-2.962.059h.036c.142 0 .27.048.399.135c.146.129.264.288.344.465c.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024c-.152.055-.274.135-.393.2q.018-.136.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.6.6 0 0 0-.166-.267a.25.25 0 0 0-.183-.064h-.021c-.071.006-.13.04-.186.132a.55.55 0 0 0-.12.27a1 1 0 0 0-.023.33v.015c.012.135.037.2.08.334c.046.134.098.2.166.268q.014.014.034.024c-.07.057-.117.07-.176.136a.3.3 0 0 1-.131.068a2.6 2.6 0 0 1-.275-.402a1.8 1.8 0 0 1-.155-.667a1.8 1.8 0 0 1 .08-.668a1.4 1.4 0 0 1 .283-.535c.128-.133.26-.2.418-.2m1.37 1.706c.332 0 .733.065 1.216.399c.293.2.523.269 1.052.468h.003c.255.136.405.266.478.399v-.131a.57.57 0 0 1 .016.47c-.123.31-.516.643-1.063.842v.002c-.268.135-.501.333-.775.465c-.276.135-.588.292-1.012.267a1.1 1.1 0 0 1-.448-.067a4 4 0 0 1-.322-.198c-.195-.135-.363-.332-.612-.465v-.005h-.005c-.4-.246-.616-.512-.686-.71q-.104-.403.193-.6c.224-.135.38-.271.483-.336c.104-.074.143-.102.176-.131h.002v-.003c.169-.202.436-.47.839-.601c.139-.036.294-.065.466-.065zm2.8 2.142c.358 1.417 1.196 3.475 1.735 4.473c.286.534.855 1.659 1.102 3.024c.156-.005.33.018.513.064c.646-1.671-.546-3.467-1.089-3.966c-.22-.2-.232-.335-.123-.335c.59.534 1.365 1.572 1.646 2.757c.13.535.16 1.104.021 1.67c.067.028.135.06.205.067c1.032.534 1.413.938 1.23 1.537v-.043c-.06-.003-.12 0-.18 0h-.016c.151-.467-.182-.825-1.065-1.224c-.915-.4-1.646-.336-1.77.465c-.008.043-.013.066-.018.135c-.068.023-.139.053-.209.064c-.43.268-.662.669-.793 1.187c-.13.533-.17 1.156-.205 1.869v.003c-.02.334-.17.838-.319 1.35c-1.5 1.072-3.58 1.538-5.348.334a2.7 2.7 0 0 0-.402-.533a1.5 1.5 0 0 0-.275-.333c.182 0 .338-.03.465-.067a.62.62 0 0 0 .314-.334c.108-.267 0-.697-.345-1.163s-.931-.995-1.788-1.521c-.63-.4-.986-.87-1.15-1.396c-.165-.534-.143-1.085-.015-1.645c.245-1.07.873-2.11 1.274-2.763c.107-.065.037.135-.408.974c-.396.751-1.14 2.497-.122 3.854a8.1 8.1 0 0 1 .647-2.876c.564-1.278 1.743-3.504 1.836-5.268c.048.036.217.135.289.202c.218.133.38.333.59.465c.21.201.477.335.876.335q.058.005.11.006c.412 0 .73-.134.997-.268c.29-.134.52-.334.74-.4h.005c.467-.135.835-.402 1.044-.7zm2.185 8.958c.037.6.343 1.245.882 1.377c.588.134 1.434-.333 1.791-.765l.211-.01c.315-.007.577.01.847.268l.003.003c.208.199.305.53.391.876c.085.4.154.78.409 1.066c.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595c-.63.401-1.746.712-2.457 1.57c-.618.737-1.37 1.14-2.036 1.191c-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69c.176-.668.428-1.344.463-1.897c.037-.714.076-1.335.195-1.814c.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01q.08 0 .157.014c.376.055.706.333 1.023.752l.91 1.664l.003.003c.243.533.754 1.064 1.189 1.637c.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294c-.645.135-1.52.002-2.395-.464c-.968-.536-2.118-.469-2.857-.602q-.553-.1-.723-.4c-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118c-.055-.401-.083-.71.043-.94c.16-.334.396-.4.69-.533c.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838c.19-.201.38-.336.663-.336m7.159-9.074c-.435.201-.945.535-1.488.535c-.542 0-.97-.267-1.28-.466c-.154-.134-.28-.268-.373-.335c-.164-.134-.144-.333-.074-.333c.109.016.129.134.199.2c.096.066.215.2.36.333c.292.2.68.467 1.167.467c.485 0 1.053-.267 1.398-.466c.195-.135.445-.334.648-.467c.156-.136.149-.267.279-.267c.128.016.034.134-.147.332a8 8 0 0 1-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05c.074-.043.18-.027.26.004c.063 0 .16.067.15.135c-.006.049-.085.066-.135.066c-.055 0-.092-.043-.141-.068c-.052-.018-.146-.008-.163-.065m-.551 0c-.02.058-.113.049-.166.066c-.047.025-.086.068-.14.068c-.05 0-.13-.02-.136-.068c-.01-.066.088-.133.15-.133c.08-.031.184-.047.259-.005c.019.009.036.03.03.05v.02h.003z"/>
          </svg>
          <span>Linux</span>
        </button>

        <button 
          type="button" 
          class="platform-pill" 
          role="tab" 
          id="pill-android" 
          data-platform="android" 
          aria-selected="false"
          aria-controls="panel-android"
        >
          <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.44 5.559q-1.015 1.748-2.028 3.498q-.055-.023-.111-.043a12.1 12.1 0 0 0-8.68.033C7.537 8.897 5.868 6.026 5.6 5.56a1 1 0 0 0-.141-.19a1.104 1.104 0 0 0-1.768 1.298c1.947 3.37-.096-.216 1.948 3.36c.017.03-.495.263-1.393 1.017C2.9 12.176.452 14.772 0 18.99h24a11.7 11.7 0 0 0-.746-3.068a12.1 12.1 0 0 0-2.74-4.184a12 12 0 0 0-2.131-1.687c.66-1.122 1.312-2.256 1.965-3.385a1.11 1.11 0 0 0-.008-1.12a1.1 1.1 0 0 0-.852-.532c-.522-.054-.939.313-1.049.545m-.04 8.46c.395.593.324 1.331-.156 1.65c-.48.32-1.188.1-1.582-.493s-.324-1.33.156-1.65c.473-.316 1.182-.11 1.582.494m-11.193-.492c.48.32.55 1.058.156 1.65c-.394.593-1.103.815-1.584.495c-.48-.32-.55-1.058-.156-1.65c.4-.603 1.109-.811 1.584-.495"/>
          </svg>
          <span>Android</span>
        </button>
      </div>

      <!-- Binary Download Panels Section -->
      <div class="binaries-section-header">
        <h2 class="binaries-section-label">BINARIES</h2>
      </div>

      <!-- Platform Panels -->
      <div class="download-panels-container">
        {Object.entries(platformData).map(([key, data]) => (
          <div 
            class={`platform-download-panel ${key === 'linux' ? 'active' : ''}`}
            id={`panel-${key}`}
            role="tabpanel"
            aria-labelledby={`pill-${key}`}
            hidden={key !== 'linux'}
          >
            <div class="binaries-list">
              {data.binaries.map((binary) => (
                <a 
                  href={binary.url} 
                  data-asset-id={binary.id}
                  target={binary.isExternal ? "_blank" : undefined}
                  rel={binary.isExternal ? "noopener noreferrer" : undefined}
                  class="binary-card"
                  title={`Download ${binary.name} for ${data.name}`}
                >
                  <div class="binary-info">
                    <div class="binary-title-row">
                      <span class="binary-title">{binary.name}</span>
                      <span class="binary-badge">{binary.badge}</span>
                    </div>
                    <p class="binary-desc">{binary.desc}</p>
                  </div>
                  
                  <div class="binary-action-btn" aria-hidden="true">
                    {binary.isExternal ? (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                      </svg>
                    ) : (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M7 11l5 5l5-5m-5-7v12"/>
                      </svg>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Additional Releases Note -->
      <div class="releases-note-card">
        <p>
          Looking for previous releases, checksums, or source code? 
          <a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener noreferrer" class="releases-link">
            Browse all GitHub Releases ↗
          </a>
        </p>
      </div>

    </div>
  </div>
</Layout>

<style>
  .download-page-wrapper {
    padding: 70px 0 90px;
    min-height: calc(100vh - 200px);
  }

  /* Centered Header */
  .download-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .download-page-title {
    font-size: clamp(2.6rem, 5vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .download-version-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 14px;
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--md-sys-color-primary);
    margin-bottom: 12px;
  }

  .version-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  .download-platform-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  /* Platform Nav Pills */
  .platform-nav-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .platform-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    background: var(--md-sys-color-surface-container-low);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    user-select: none;
  }

  .platform-pill:hover {
    background: var(--md-sys-color-surface-container-high);
    color: var(--text-primary);
    border-color: var(--md-sys-color-outline);
    transform: translateY(-1px);
  }

  /* Active Pill Highlight (UX style matching reference) */
  .platform-pill.active {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    border-color: var(--md-sys-color-primary);
    box-shadow: 0 4px 16px rgba(0, 83, 219, 0.28);
  }

  .platform-pill.active .pill-icon {
    color: var(--md-sys-color-on-primary);
  }

  .pill-icon {
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  /* Binaries Section Label */
  .binaries-section-header {
    max-width: 680px;
    margin: 0 auto 16px;
    padding-left: 4px;
  }

  .binaries-section-label {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--md-sys-color-primary);
  }

  /* Panels Container */
  .download-panels-container {
    max-width: 680px;
    margin: 0 auto 40px;
  }

  .platform-download-panel {
    display: none;
    animation: fadeInPanel 0.22s ease forwards;
  }

  .platform-download-panel.active {
    display: block;
  }

  @keyframes fadeInPanel {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Binaries Cards */
  .binaries-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .binary-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 24px;
    background: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .binary-card:hover {
    background: var(--md-sys-color-surface-container-low);
    border-color: var(--md-sys-color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .binary-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .binary-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .binary-title {
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .binary-badge {
    font-size: 0.76rem;
    font-family: var(--font-mono);
    font-weight: 600;
    padding: 2px 8px;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: var(--radius-full);
  }

  .binary-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .binary-action-btn {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .binary-card:hover .binary-action-btn {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    border-color: var(--md-sys-color-primary);
    transform: scale(1.05);
  }

  /* Releases Note Card */
  .releases-note-card {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    padding: 20px 24px;
    background: var(--md-sys-color-surface-container-low);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .releases-link {
    color: var(--md-sys-color-primary);
    font-weight: 600;
    text-decoration: underline;
    margin-left: 4px;
  }

  .releases-link:hover {
    color: var(--accent-primary-hover);
  }

  @media (max-width: 640px) {
    .download-page-wrapper {
      padding: 40px 0 60px;
    }
    .platform-nav-bar {
      gap: 8px;
    }
    .platform-pill {
      padding: 8px 18px;
      font-size: 0.9rem;
    }
    .binary-card {
      padding: 16px 18px;
    }
    .binary-title {
      font-size: 1.05rem;
    }
    .binary-desc {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  // Platform management script: Auto-detection + Live Switching
  const pills = document.querySelectorAll('.platform-pill');
  const panels = document.querySelectorAll('.platform-download-panel');
  const subtitle = document.getElementById('platform-subtitle');

  const titles: Record<string, string> = {
    windows: 'Windows Downloads',
    linux: 'Linux Downloads',
    android: 'Android Downloads',
  };

  function detectClientOS(): string {
    // 1. Check URL parameters and hash first (e.g. ?platform=linux or #linux)
    const urlParams = new URLSearchParams(window.location.search);
    const hash = window.location.hash.replace('#', '').toLowerCase();
    const query = urlParams.get('platform')?.toLowerCase();
    const explicit = query || hash;

    if (explicit && ['windows', 'linux', 'android'].includes(explicit)) {
      return explicit;
    }

    // 2. Auto-detect from navigator.userAgent
    const ua = navigator.userAgent.toLowerCase();
    if (ua.includes('android')) return 'android';
    if (ua.includes('linux') || ua.includes('x11')) return 'linux';
    if (ua.includes('win')) return 'windows';

    // Fallback default
    return 'linux';
  }

  function setPlatform(platform: string, updateUrl = true) {
    if (!['windows', 'linux', 'android'].includes(platform)) {
      platform = 'linux';
    }

    // Update pills
    pills.forEach((pill) => {
      const isTarget = pill.getAttribute('data-platform') === platform;
      pill.classList.toggle('active', isTarget);
      pill.setAttribute('aria-selected', String(isTarget));
    });

    // Update panels
    panels.forEach((panel) => {
      const isTarget = panel.id === `panel-${platform}`;
      panel.classList.toggle('active', isTarget);
      (panel as HTMLElement).hidden = !isTarget;
    });

    // Update subtitle
    if (subtitle && titles[platform]) {
      subtitle.textContent = titles[platform];
    }

    // Update URL hash / param without reloading page
    if (updateUrl && window.history && window.history.replaceState) {
      const url = new URL(window.location.href);
      url.searchParams.set('platform', platform);
      window.history.replaceState(null, '', url.toString());
    }
  }

  // Pill click handlers
  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const targetPlatform = pill.getAttribute('data-platform');
      if (targetPlatform) {
        setPlatform(targetPlatform, true);
      }
    });
  });

  // Handle browser back/forward navigation
  window.addEventListener('popstate', () => {
    const os = detectClientOS();
    setPlatform(os, false);
  });

  // Initial detection on load
  const initialOS = detectClientOS();
  setPlatform(initialOS, false);

  // Dynamically resolve latest stable or fallback pre-release binary downloads
  import('../scripts/release-resolver');
</script>
