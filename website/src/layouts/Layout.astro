---
// Layout.astro
import Navbar from '../components/Navbar.astro';
import DownloadModal from '../components/DownloadModal.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Folder Share — Stream Videos & Share Folders Across TV, PC & Phone",
  description = "Share folders and stream videos directly between your phones, computers, and TV over your home Wi-Fi — zero setup, seekable playback, no cloud, completely free."
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://hammadbawara.github.io').toString();
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}app-icon.png`, Astro.site ?? 'https://hammadbawara.github.io').toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="local network file sharing, stream video to tv over wifi, watch pc movies on android tv, local webdav server, seekable streaming http 206, offline file sharing" />
    <meta name="theme-color" content="#fefbff" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD for Google Rich Results -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "SoftwareApplication",
          "name": "Folder Share",
          "applicationCategory": "UtilitiesApplication",
          "operatingSystem": "Windows, Linux, Android, Android TV",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "description": description,
          "url": canonicalUrl,
          "image": ogImageUrl,
          "featureList": [
            "Zero-setup local Wi-Fi peer discovery",
            "Seekable HTTP 206 video streaming for TV and mobile",
            "Direct TV playback without USB drives or cables",
            "WebDAV protocol support for VLC, Kodi, and file managers",
            "100% offline and private local network sharing"
          ]
        },
        {
          "@type": "WebSite",
          "name": "Folder Share",
          "url": Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).toString() : "https://hammadbawara.github.io/FolderShare/",
          "description": "Zero-touch local file sharing and seekable video streaming across PC, Android, and Smart TV over home Wi-Fi."
        }
      ]
    })} />

    <!-- Font preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <Navbar />
    
    <main id="main-content">
      <slot />
    </main>

    <DownloadModal />

    <Footer />
  </body>
</html>
