---
// MainBenefit.astro
---

<section class="benefit-section" id="streaming">
  <div class="container benefit-container">
    <div class="section-header">
      <span class="section-tag">Instant TV Streaming</span>
      <h2 class="section-title">Watch 4K movies on your TV without copying or USB drives</h2>
      <p class="section-desc">
        Stream large video files directly from your PC or phone over Wi-Fi with instant scrubbing (HTTP 206) — no copying, no buffering, zero wait time.
      </p>
    </div>

    <!-- Cinematic TV Streaming Showcase -->
    <div class="benefit-showcase-wrapper">
      <!-- Ambient Glow Behind TV -->
      <div class="tv-ambient-glow" aria-hidden="true"></div>

      <!-- TV Mockup Frame -->
      <div class="device-frame-tv benefit-tv-frame">
        <!-- Direct Stream Indicator Bar -->
        <div class="stream-status-bar" aria-label="Streaming status indicators">
          <span class="status-chip live-chip">
            <span class="pulse-dot"></span>
            Direct Local Stream
          </span>
          <span class="status-chip">
            0-Second Copy Time
          </span>
          <span class="status-chip">
            Instant Scrubbing
          </span>
        </div>

        <div class="device-tv-screen benefit-tv-screen">
          <img 
            src={`${import.meta.env.BASE_URL}screenshots/media-playing-tv.gif`} 
            alt="Seamless video playback on TV streamed directly from local phone folder"
            loading="lazy"
            width="600"
            height="337"
          />
        </div>

        <div class="device-tv-chin">
          <span class="device-tv-led"></span>
          <span class="device-tv-brand">SMART TV PLAYBACK</span>
        </div>
      </div>

      <!-- 3 Real-World Streaming Advantages -->
      <div class="streaming-benefits-grid">
        <div class="benefit-item">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
          </div>
          <div class="benefit-text">
            <h4 class="benefit-heading">Zero Copy Time</h4>
            <p class="benefit-sub">Starts playing in under 1 second. No waiting for 10GB-50GB files to transfer.</p>
          </div>
        </div>

        <div class="benefit-item">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <div class="benefit-text">
            <h4 class="benefit-heading">Instant Video Scrubbing</h4>
            <p class="benefit-sub">Jump forward, rewind, or skip anywhere in the video smoothly without buffering.</p>
          </div>
        </div>

        <div class="benefit-item">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242M8 19l4 4 4-4m-4 4V13"/>
            </svg>
          </div>
          <div class="benefit-text">
            <h4 class="benefit-heading">Saves TV Storage</h4>
            <p class="benefit-sub">TVs have limited storage. Stream large collections directly from your phone or PC.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .benefit-section {
    padding: 85px 0;
    background: var(--md-sys-color-surface-container-low);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
  }

  .benefit-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 960px;
  }

  .benefit-showcase-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .benefit-tv-frame {
    width: 100%;
    max-width: 840px;
    z-index: 1;
  }

  .stream-status-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    width: 100%;
  }

  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    color: #e2e8f0;
  }

  .live-chip {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border-color: rgba(34, 197, 94, 0.35);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.9); opacity: 0.8; }
  }

  .streaming-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    max-width: 860px;
    margin-top: 36px;
    z-index: 1;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px 18px;
    background: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .benefit-item:hover {
    transform: translateY(-2px);
    border-color: var(--md-sys-color-primary);
  }

  .benefit-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .benefit-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .benefit-heading {
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .benefit-sub {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  @media (max-width: 768px) {
    .benefit-section {
      padding: 60px 0;
    }
    .stream-status-bar {
      gap: 6px;
      margin-bottom: 10px;
    }
    .status-chip {
      font-size: 0.74rem;
      padding: 4px 10px;
    }
    .streaming-benefits-grid {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 24px;
    }
    .benefit-item {
      padding: 16px 14px;
    }
  }
</style>
