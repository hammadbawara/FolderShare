---
// Navbar.astro
const GITHUB_REPO = "https://github.com/hammadbawara/FolderShare";
---

<header class="navbar-header" id="top-nav">
  <div class="container navbar-inner">
    <a href={import.meta.env.BASE_URL} class="brand-link" aria-label="Folder Share Home">
      <div class="brand-icon-wrapper">
        <img 
          src={`${import.meta.env.BASE_URL}app-icon.png`} 
          alt="Folder Share Logo" 
          class="brand-app-icon" 
          width="36" 
          height="36" 
        />
      </div>
      <span class="brand-name">Folder Share</span>
    </a>

    <nav class="nav-links" id="desktop-nav" aria-label="Main Navigation">
      <a href={`${import.meta.env.BASE_URL}#features`} class="nav-link">Features</a>
      <a href={`${import.meta.env.BASE_URL}#streaming`} class="nav-link">Streaming</a>
      <a href={`${import.meta.env.BASE_URL}#how-it-works`} class="nav-link">How It Works</a>
      <a href={`${import.meta.env.BASE_URL}#faq`} class="nav-link">FAQ</a>
    </nav>

    <div class="nav-actions">
      <a 
        href={GITHUB_REPO} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-ghost github-btn"
        aria-label="View Folder Share on GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385c.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729c1.205.084 1.838 1.236 1.838 1.236c1.07 1.835 2.809 1.305 3.495.998c.108-.776.417-1.305.76-1.605c-2.665-.3-5.466-1.332-5.466-5.93c0-1.31.465-2.38 1.235-3.22c-.135-.303-.54-1.523.105-3.176c0 0 1.005-.322 3.3 1.23c.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92c.42.36.81 1.096.81 2.22c0 1.606-.015 2.896-.015 3.286c0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        <span class="github-text">GitHub</span>
      </a>

      <a 
        href={`${import.meta.env.BASE_URL}download`} 
        class="btn btn-primary nav-download-btn"
      >
        Download
      </a>
    </div>
  </div>
</header>

<style>
  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(254, 251, 255, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 20px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-icon-wrapper {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 4px rgba(0, 83, 219, 0.15));
  }

  .brand-app-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
  }

  .brand-name {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--md-sys-color-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--md-sys-color-primary);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .github-btn {
    padding: 8px 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
  }

  .github-btn:hover {
    border-color: var(--md-sys-color-outline);
    color: var(--text-primary);
  }

  .nav-download-btn {
    padding: 9px 20px;
    font-size: 0.9rem;
  }

  @media (max-width: 680px) {
    .nav-links {
      display: none;
    }
  }
</style>
